---
import Layout from "@/layouts/Layout.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card.tsx";
import { Badge } from "@/components/ui/badge.tsx";
import { Alert, AlertTitle, AlertDescription } from "@/components/ui/alert.tsx";
---

<Layout
  title="About Web ROM Validator"
  description="Learn how Web ROM Validator checks ROM files against No-Intro and Redump databases in your browser."
>
  <main class="container mx-auto max-w-4xl px-4 py-8">
    <div class="space-y-8">
      <!-- Header -->
      <div class="space-y-4 text-center">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          About Web ROM Validator
        </h1>
        <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
          Check ROM files against official databases in your browser
        </p>
      </div>

      <!-- What is ROM Validation -->
      <div class="bg-card rounded-lg border shadow-sm">
        <div class="p-6">
          <h2 class="mb-4 text-2xl font-semibold">What is ROM Validation?</h2>
          <div class="space-y-4">
            <p class="text-muted-foreground">
              ROM validation checks that a ROM file matches a known good copy.
              The app compares hashes from your file against hashes in a
              database. This shows if your copy is correct and complete.
            </p>

            <p class="text-muted-foreground">
              A DAT file stores the official game name and hash data for each
              release. No-Intro and Redump publish these files. The app
              downloads the DAT files it needs for each platform.
            </p>

            <p class="text-muted-foreground">
              Validation does not fix corrupted files. It only shows if your
              file matches the database. You can then rename files to match the
              official name.
            </p>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
              <Alert className="border-primary/20 bg-primary/5">
                <AlertTitle className="text-primary"> Check Hashes </AlertTitle>
                <AlertDescription>
                  The app calculates MD5, SHA-1, and CRC32 hashes for each file
                </AlertDescription>
              </Alert>

              <Alert className="border-green-500/20 bg-green-500/5">
                <AlertTitle className="text-green-600">Compare DATs</AlertTitle>
                <AlertDescription>
                  The app compares your hashes against official No-Intro and
                  Redump DAT files
                </AlertDescription>
              </Alert>

              <Alert className="border-blue-500/20 bg-blue-500/5">
                <AlertTitle className="text-blue-600">
                  Rename Files
                </AlertTitle>
                <AlertDescription>
                  You can rename files to match the official names from the DAT
                  files
                </AlertDescription>
              </Alert>
            </div>
          </div>
        </div>
      </div>

      <!-- Supported Platforms -->
      <div class="bg-card rounded-lg border shadow-sm">
        <div class="p-6">
          <h2 class="mb-2 text-2xl font-semibold">Supported Platforms</h2>
          <p class="text-muted-foreground mb-4">
            The app supports these platforms through official DAT files
          </p>

          <h3 class="mb-2 text-lg font-medium">No-Intro</h3>
          <div
            class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4"
          >
            <Badge variant="outline">Game Boy</Badge>
            <Badge variant="outline">Game Boy Color</Badge>
            <Badge variant="outline">Game Boy Advance</Badge>
            <Badge variant="outline">Nintendo DS</Badge>
            <Badge variant="outline">Nintendo 3DS</Badge>
            <Badge variant="outline">NES</Badge>
            <Badge variant="outline">SNES</Badge>
            <Badge variant="outline">Nintendo 64</Badge>
            <Badge variant="outline">PSP</Badge>
            <Badge variant="outline">Genesis / Mega Drive</Badge>
          </div>

          <h3 class="mb-2 text-lg font-medium">Redump</h3>
          <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
            <Badge variant="outline">GameCube</Badge>
            <Badge variant="outline">Wii</Badge>
            <Badge variant="outline">PlayStation</Badge>
            <Badge variant="outline">PlayStation 2</Badge>
            <Badge variant="outline">Dreamcast</Badge>
          </div>
        </div>
      </div>

      <!-- How It Works -->
      <Card>
        <CardHeader>
          <CardTitle>How It Works</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div
                class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
              >
                1
              </div>
              <div>
                <h4 class="mb-1 font-semibold">Upload your files</h4>
                <p class="text-muted-foreground text-sm">
                  Drag and drop files onto the page, or click to select files.
                  The app reads each file locally in your browser.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
              >
                2
              </div>
              <div>
                <h4 class="mb-1 font-semibold">The app detects the platform</h4>
                <p class="text-muted-foreground text-sm">
                  The app checks file extensions, file size, and file names to
                  guess the platform. You can also select the platform manually.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
              >
                3
              </div>
              <div>
                <h4 class="mb-1 font-semibold">The app calculates hashes</h4>
                <p class="text-muted-foreground text-sm">
                  The app calculates MD5, SHA-1, and CRC32 hashes for each file.
                  Web workers process files in parallel.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
              >
                4
              </div>
              <div>
                <h4 class="mb-1 font-semibold">The app gets DAT files</h4>
                <p class="text-muted-foreground text-sm">
                  The app downloads DAT files from No-Intro or Redump. It uses
                  cached DAT files when they are less than 24 hours old.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
              >
                5
              </div>
              <div>
                <h4 class="mb-1 font-semibold">The app compares hashes</h4>
                <p class="text-muted-foreground text-sm">
                  The app compares your file hashes against the DAT database. It
                  shows match, miss, and error results for each file.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
              >
                6
              </div>
              <div>
                <h4 class="mb-1 font-semibold">You can rename or export</h4>
                <p class="text-muted-foreground text-sm">
                  You can rename a file to match the official DAT name. You can
                  also copy results to the clipboard or export them.
                </p>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Privacy -->
      <Card>
        <CardHeader>
          <CardTitle>Privacy</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <Alert className="border-green-500/20 bg-green-500/5">
            <AlertTitle className="text-green-600"
              >Your files stay on your device</AlertTitle
            >
            <AlertDescription>
              The app processes all files in your browser. It does not upload
              ROM files to any server. The only network requests are for public
              DAT files from No-Intro and Redump. The app caches these DAT
              files in memory and in localStorage for 24 hours.
            </AlertDescription>
          </Alert>

          <Alert className="border-blue-500/20 bg-blue-500/5">
            <AlertTitle className="text-blue-600"
              >No tracking or analytics</AlertTitle
            >
            <AlertDescription>
              This site does not use analytics, tracking cookies, or any
              monitoring tools. There are no third-party scripts that collect
              data about how you use the site. The only browser storage used
              is for DAT file caching, your theme preference, and validation
              settings. All stored data stays on your device and is never
              sent anywhere.
            </AlertDescription>
          </Alert>

          <Alert className="border-purple-500/20 bg-purple-500/5">
            <AlertTitle className="text-purple-600"
              >Open source and auditable</AlertTitle
            >
            <AlertDescription>
              This project is open source. You can read every line of code to
              verify these claims. The site is hosted on Cloudflare Pages.
            </AlertDescription>
            <AlertDescription className="mt-2">
              <a
                href="https://www.cloudflare.com/privacypolicy/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary font-medium hover:underline"
                >Cloudflare privacy policy</a
              >
            </AlertDescription>
            <AlertDescription className="mt-2">
              <a
                href="https://github.com/RP2/rom-validate-web"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary font-medium hover:underline"
                >View the source on GitHub</a
              >
            </AlertDescription>
          </Alert>
        </CardContent>
      </Card>

      <!-- Legal Notice -->
      <Card>
        <CardHeader>
          <CardTitle>Legal Notice</CardTitle>
        </CardHeader>
        <CardContent>
          <Alert className="border-yellow-500/20 bg-yellow-500/5">
            <AlertDescription>
              The app is for game preservation and backups of games you own. It
              is not for piracy. You must follow copyright laws in your area.
            </AlertDescription>
          </Alert>
        </CardContent>
      </Card>

      <!-- External Resources -->
      <Card>
        <CardHeader>
          <CardTitle>External Resources</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="space-y-2">
              <h4 class="font-semibold">DAT File Sources</h4>
              <div class="space-y-1">
                <a
                  href="https://datomatic.no-intro.org/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary block text-sm hover:underline"
                >
                  No-Intro DAT Files
                </a>
                <a
                  href="http://redump.org/downloads/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary block text-sm hover:underline"
                >
                  Redump DAT Files
                </a>
              </div>
            </div>

            <div class="space-y-2">
              <h4 class="font-semibold">Source Code</h4>
              <div class="space-y-1">
                <a
                  href="https://github.com/RP2/auto-rom-validator"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary block text-sm hover:underline"
                >
                  Original Python Project
                </a>
                <a
                  href="https://github.com/RP2/rom-validate-web"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary block text-sm hover:underline"
                >
                  Web ROM Validator on GitHub
                </a>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </main>
</Layout>
